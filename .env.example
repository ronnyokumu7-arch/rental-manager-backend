# ─────────────────────────────────────────────────────────────────────────
# APP IDENTIFICATION
# ─────────────────────────────────────────────────────────────────────────
FROM_NAME=Rental Garage
ENVIRONMENT=production
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────
# SECURITY & TOKENS (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters-long
ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-cryptography-base64-encoded
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────
# 🔒 RATE LIMITING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Login endpoint: strict to prevent brute force
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60

# Password reset: very strict to prevent enumeration
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW=60

# General API endpoints: more lenient
API_RATE_LIMIT=100
API_RATE_WINDOW=60

# File upload endpoints: moderate to prevent abuse
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW=60

# ─────────────────────────────────────────────────────────────────────────
# 🔒 ACCOUNT LOCKOUT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Lock account after N failed attempts
MAX_FAILED_LOGIN_ATTEMPTS=5
# Lock duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
# Window to count failed attempts (in seconds, default: 1 hour)
FAILED_ATTEMPTS_WINDOW_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────
# 🔒 SECURITY LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Log level for security events (DEBUG, INFO, WARNING, ERROR)
SECURITY_LOG_LEVEL=INFO
# Enable detailed security audit logging
ENABLE_SECURITY_AUDIT=true
# Log failed authentication attempts
LOG_FAILED_AUTH_ATTEMPTS=true
# Log rate limit violations
LOG_RATE_LIMIT_VIOLATIONS=true
# Log account lockouts
LOG_ACCOUNT_LOCKOUTS=true

# ─────────────────────────────────────────────────────────────────────────
# 🔒 PASSWORD POLICY
# ─────────────────────────────────────────────────────────────────────────
# Minimum password length (enforced at validation layer)
MIN_PASSWORD_LENGTH=8
# Maximum password length (bcrypt limit is 72 bytes)
MAX_PASSWORD_LENGTH=72
# Require at least one uppercase letter
REQUIRE_UPPERCASE=true
# Require at least one lowercase letter
REQUIRE_LOWERCASE=true
# Require at least one number
REQUIRE_NUMBER=true
# Require at least one special character
REQUIRE_SPECIAL_CHAR=false

# ─────────────────────────────────────────────────────────────────────────
# 🔒 SESSION SECURITY
# ─────────────────────────────────────────────────────────────────────────
# Force logout on password change
LOGOUT_ON_PASSWORD_CHANGE=true
# Maximum concurrent sessions per user (0 = unlimited)
MAX_CONCURRENT_SESSIONS=5
# Session timeout in minutes (0 = use token expiry)
SESSION_TIMEOUT_MINUTES=0

# ─────────────────────────────────────────────────────────────────────────
# 🔒 BRUTE FORCE PROTECTION
# ─────────────────────────────────────────────────────────────────────────
# Enable IP-based rate limiting
ENABLE_IP_RATE_LIMITING=true
# Enable account-based lockout
ENABLE_ACCOUNT_LOCKOUT=true
# Enable CAPTCHA after N failed attempts (future feature)
ENABLE_CAPTCHA_AFTER_FAILURES=false
CAPTCHA_THRESHOLD=3

# ─────────────────────────────────────────────────────────────────────────
# 🔒 SECURITY HEADERS
# ─────────────────────────────────────────────────────────────────────────
# Enable HSTS (HTTP Strict Transport Security)
ENABLE_HSTS=true
# HSTS max age in seconds (default: 1 year)
HSTS_MAX_AGE=31536000
# Include subdomains in HSTS
HSTS_INCLUDE_SUBDOMAINS=true
# Enable HSTS preload (requires submission to preload list)
HSTS_PRELOAD=false

# ─────────────────────────────────────────────────────────────────────────
# 🔒 FILE UPLOAD SECURITY
# ─────────────────────────────────────────────────────────────────────────
# Maximum file size in bytes (default: 10MB = 10 * 1024 * 1024)
MAX_UPLOAD_SIZE=10485760

# ─────────────────────────────────────────────────────────────────────────
# DATABASE (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/rental_manager

# ─────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# URLS & PATHS
# ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
PUBLIC_URL_BASE=replace_with_your_public_url_base
UPLOADS_DIR=./uploads
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key

# ─────────────────────────────────────────────────────────────────────────
# SUPERADMIN (REQUIRED - NO DEFAULT!)
# ─────────────────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.com
# ⚠️ Use only a development value locally. Never deploy this default password.
SUPERADMIN_PASSWORD=replace-me-before-running

# ─────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=replace_me_with_original_key_from_resend

# ─────────────────────────────────────────────────────────────────────────
# STORAGE BACKEND (Cloudinary or local disk)
# Switch via: STORAGE_BACKEND=cloudinary | local (default)
# ─────────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=replace_with_your_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret