FROM_NAME=Rental Garage
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-cryptography
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql://postgres:password@localhost:5432/rental_manager
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=./uploads
SUPERADMIN_EMAIL=admin@example.com
# Use only a development value locally. Never deploy this default password.
SUPERADMIN_PASSWORD=replace-me-before-running-
RESEND_API_KEY=replace_me_with_original_key_from_resend
PUBLIC_URL_BASE=replace_with_your_public_url_base
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=replace_with_your_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret