APP_NAME=Rental Manager API
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-cryptography
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql://postgres:password@localhost:5432/rental_manager
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=./uploads
# Use only a development value locally. Never deploy this default password.
SUPERADMIN_PASSWORD=replace-me-before-running-seeds
