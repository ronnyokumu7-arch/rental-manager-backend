PORT=10000
ENVIRONMENT=production
DEBUG=false
FROM_NAME=Rental Garage
FROM_EMAIL=onboarding@resend.dev
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters-long
ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-cryptography-base64-encoded
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW=60
API_RATE_LIMIT=100
API_RATE_WINDOW=60
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW=60
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPTS_WINDOW_SECONDS=3600
SECURITY_LOG_LEVEL=INFO
ENABLE_SECURITY_AUDIT=true
LOG_FAILED_AUTH_ATTEMPTS=true
LOG_RATE_LIMIT_VIOLATIONS=true
LOG_ACCOUNT_LOCKOUTS=true
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=72
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBER=true
REQUIRE_SPECIAL_CHAR=false
LOGOUT_ON_PASSWORD_CHANGE=true
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT_MINUTES=0
ENABLE_IP_RATE_LIMITING=true
ENABLE_ACCOUNT_LOCKOUT=true
ENABLE_CAPTCHA_AFTER_FAILURES=false
CAPTCHA_THRESHOLD=3
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
MAX_UPLOAD_SIZE=10485760
DATABASE_URL=postgresql://postgres:password@localhost:5432/rental_manager
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,https://rentalgarage.co.ke,https://www.rentalgarage.co.ke,https://royride.com,https://www.royride.com,https://rentalgarage.vercel.app
FRONTEND_URL=https://rentalgarage.co.ke
PUBLIC_URL_BASE=https://rental-manager-backend-live.onrender.com
UPLOADS_DIR=./uploads
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-me-before-running
RESEND_API_KEY=replace_me_with_original_key_from_resend
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=replace_with_your_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret
CRON_SECRET=replace_with_your_cron_secret